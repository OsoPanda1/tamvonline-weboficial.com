# Copy into Vercel Project Settings > Environment Variables.
# Never commit real credentials or values from the Auth0/Supabase dashboards.

# Canonical production hostname (Auth0 callback uses /api/auth/callback).
APP_BASE_URL=https://tamv.online
TAMV_SITE_URL=https://tamv.online

# Auth0: Regular Web Application. The implementation uses OIDC Authorization Code + PKCE.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate with: openssl rand -hex 32 (server-only; do not use NEXT_PUBLIC_ prefix).
AUTH0_SECRET=

# Supabase project URL. SUPABASE_URL is preferred; NEXT_PUBLIC_SUPABASE_URL is accepted as a URL fallback only.
SUPABASE_URL=https://your-project-ref.supabase.co
# Use one server-only key. Prefer the service role key / secret key and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Alternative for newer Supabase API keys:
# SUPABASE_SECRET_KEY=

# Leave false until the SQL migration is applied, Auth0 callback URLs are set, and the privacy/legal gate below is complete.
TAMV_REGISTRATION_ENABLED=false

# Required before registration can be enabled. These must reflect the actual data controller and service address.
TAMV_DATA_CONTROLLER_NAME=
TAMV_DATA_CONTROLLER_ADDRESS=
TAMV_PRIVACY_CONTACT_EMAIL=


# Public metadata connector courtesy details (used in server-side User-Agent where supported).
TAMV_CONTACT_EMAIL=

# Optional EPO Open Patent Services OAuth application credentials.
# Obtain them from https://developers.epo.org/; keep secrets server-side.
EPO_OPS_KEY=
EPO_OPS_SECRET=

# Research audit snapshots are disabled until migration 202610270002 is applied and tested.
TAMV_RESEARCH_AUDIT_PERSISTENCE_ENABLED=false

# USPTO Open Data Portal requires an API key. The current adapter documents the source
# but does not yet execute a general patent-search query against it.
USPTO_ODP_API_KEY=


# Optional NCBI E-utilities API key for higher request allowance; public PubMed lookup works without it.
NCBI_API_KEY=

# VETRA proposal intake stays closed until the migration, privacy notice and review governance have passed validation.
TAMV_VETRA_SUBMISSIONS_ENABLED=false
# Set true only after privacy/legal review approves an explicit retention and deletion policy for proposal/review records.
TAMV_VETRA_RETENTION_POLICY_APPROVED=false
# Set true only after migration 003 and the VETRA RLS/grant checks have been run successfully in the target Supabase project.
TAMV_VETRA_SCHEMA_VERIFIED=false

# Manual approval flag after the VETRA governance charter, conflict process and appeal procedure are formally approved.
TAMV_VETRA_GOVERNANCE_APPROVED=false
# Reviewer/decision consoles have no access until individually appointed email addresses are explicitly allowlisted.
TAMV_VETRA_REVIEW_CONSOLE_ENABLED=false
TAMV_VETRA_REVIEWER_EMAILS=
TAMV_VETRA_DECISION_CONSOLE_ENABLED=false
TAMV_VETRA_DECISION_EMAILS=


# Auth0 upstream connections: connection names configured in the Auth0 tenant.
# For GitHub, create/enable the social connection, request only identity/email scopes needed,
# and confirm the Auth0 callback URL: APP_BASE_URL/api/auth/callback.
AUTH0_GITHUB_CONNECTION=
# Optional Auth0 OpenID Connect connection backed by ORCID. This is separate from ORCID's
# direct OAuth linking below and requires a correctly configured upstream OIDC connection.
AUTH0_ORCID_CONNECTION=

# Direct ORCID OAuth2 for ORCID-first onboarding and linking an existing TAMV member.
# Register the exact redirect URI: APP_BASE_URL/api/orcid/callback
# This authenticates the ORCID iD only; Auth0 email verification remains a separate step.
# The server requests only /authenticate and never stores the ORCID access token.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
